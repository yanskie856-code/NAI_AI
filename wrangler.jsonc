{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nai-ai",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "nai-auth",
      "database_id": "77bfa380-de19-4391-a52a-0f60f52fdc01"
    }
  ]
}
